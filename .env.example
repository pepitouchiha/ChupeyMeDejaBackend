# --- Desarrollo local -------------------------------------------------------
# Sin DATABASE_URL se usa SQLite en backend/chupeymedeja.db.
# Para usar Supabase también en local, pega aquí su cadena de conexión.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./chupeymedeja.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Producción (Render) ----------------------------------------------------
# Estas variables se configuran en el panel de Render, NO en este archivo:
# ENVIRONMENT=production
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   (Supabase > Connect > "Session pooler". Render no soporta IPv6, por eso
#    no sirve la "Direct connection".)
# CORS_ORIGINS=https://<tu-sitio>.netlify.app
# JWT_SECRET_KEY=<64+ caracteres aleatorios; Render lo puede generar>
